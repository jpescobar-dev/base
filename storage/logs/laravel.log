    \"<span class=sf-dump-key>tipo_ejecucion</span>\" => \"<span class=sf-dump-str title=\"6 characters\">openai</span>\"
    \"<span class=sf-dump-key>resumen</span>\" => \"<span class=sf-dump-str title=\"1336 characters\">Tipo: Licitaci&#243;n p&#250;blica para servicio de mantenci&#243;n preventiva y correctiva de calderas de calefacci&#243;n || Entidad: Corporaci&#243;n Administrativa del Poder Judicial || Riesgo general: alto || Observaciones clave: La documentaci&#243;n revisada corresponde solo a bases administrativas generales y especiales; no se encuentra contrato suscrito, resoluci&#243;n de adjudicaci&#243;n, resoluci&#243;n aprobatoria, bases t&#233;cnicas, oferta adjudicataria ni dem&#225;s antecedentes esenciales del expediente. | No es posible evaluar alineaci&#243;n entre bases, adjudicaci&#243;n y contrato por ausencia de documentos de jerarqu&#237;a superior y de ejecuci&#243;n del proceso. | Las bases administrativas generales contienen una regla de prelaci&#243;n documental distinta de la jerarqu&#237;a metodol&#243;gica instruida para esta revisi&#243;n; para efectos del an&#225;lisis solo puede verificarse coherencia interna parcial entre ambas bases. | La reuni&#243;n informativa es calificada como obligatoria en las bases administrativas especiales, lo que constituye un requisito relevante de admisibilidad o participaci&#243;n que queda pendiente de verificar por falta de acta o antecedentes del proceso. | Se establece garant&#237;a de seriedad de la oferta con exigencias espec&#237;ficas de monto, vigencia, glosa, beneficiario y forma de entrega; su existencia y suficiencia no pueden verificarse con la documentaci&#243;n disponible.</span>\"
    \"<span class=sf-dump-key>json_resultado</span>\" => \"<span class=sf-dump-str title=\"10185 characters\">{&quot;resumen&quot;: {&quot;entidad&quot;: &quot;Corporaci&#243;n Administrativa del Poder Judicial&quot;, &quot;tipo_contrato&quot;: &quot;Licitaci&#243;n p&#250;blica para servicio de mantenci&#243;n preventiva y correctiva de calderas de calefacci&#243;n&quot;, &quot;riesgo_general&quot;: &quot;alto&quot;, &quot;observaciones_clave&quot;: [&quot;La documentaci&#243;n revisada corresponde solo a bases administrativas generales y especiales; no se encuentra contrato suscrito, resoluci&#243;n de adjudicaci&#243;n, resoluci&#243;n aprobatoria, bases t&#233;cnicas, oferta adjudicataria ni dem&#225;s antecedentes esenciales del expediente.&quot;, &quot;No es posible evaluar alineaci&#243;n entre bases, adjudicaci&#243;n y contrato por ausencia de documentos de jerarqu&#237;a superior y de ejecuci&#243;n del proceso.&quot;, &quot;Las bases administrativas generales contienen una regla de prelaci&#243;n documental distinta de la jerarqu&#237;a metodol&#243;gica instruida para esta revisi&#243;n; para efectos del an&#225;lisis solo puede verificarse coherencia interna parcial entre ambas bases.&quot;, &quot;La reuni&#243;n informativa es calificada como obligatoria en las bases administrativas especiales, lo que constituye un requisito relevante de admisibilidad o participaci&#243;n que queda pendiente de verificar por falta de acta o antecedentes del proceso.&quot;, &quot;Se establece garant&#237;a de seriedad de la oferta con exigencias espec&#237;ficas de monto, vigencia, glosa, beneficiario y forma de entrega; su existencia y suficiencia no pueden verificarse con la documentaci&#243;n disponible.&quot;]}, &quot;checklist&quot;: {&quot;coherencia&quot;: [{&quot;item&quot;: &quot;Coherencia del objeto entre bases administrativas generales y especiales&quot;, &quot;estado&quot;: &quot;cumple&quot;, &quot;observacion&quot;: &quot;Las bases generales regulan el marco del proceso y las especiales identifican el servicio espec&#237;fico de mantenci&#243;n preventiva y correctiva de calderas; no se advierte contradicci&#243;n expresa.&quot;}, {&quot;item&quot;: &quot;Coherencia de la formalizaci&#243;n mediante contrato con las bases revisadas&quot;, &quot;estado&quot;: &quot;cumple&quot;, &quot;observacion&quot;: &quot;Las bases especiales se&#241;alan que la contrataci&#243;n se formalizar&#225; mediante contrato, sin contradicci&#243;n con las bases generales revisadas.&quot;}, {&quot;item&quot;: &quot;Coherencia de reglas de prelaci&#243;n entre documentos revisados&quot;, &quot;estado&quot;: &quot;pendiente&quot;, &quot;observacion&quot;: &quot;Las bases generales establecen una prelaci&#243;n documental propia del proceso, distinta de la jerarqu&#237;a metodol&#243;gica instruida para esta revisi&#243;n. No constituye por s&#237; sola contradicci&#243;n invalidante, pero obliga a distinguir el orden interno de las bases del criterio anal&#237;tico aplicado en esta revisi&#243;n.&quot;}, {&quot;item&quot;: &quot;Coherencia de monto, plazo y garant&#237;as entre bases, adjudicaci&#243;n y contrato&quot;, &quot;estado&quot;: &quot;pendiente&quot;, &quot;observacion&quot;: &quot;No es posible concluir por ausencia de resoluci&#243;n de adjudicaci&#243;n y contrato suscrito.&quot;}, {&quot;item&quot;: &quot;Coherencia entre bases administrativas especiales y bases t&#233;cnicas&quot;, &quot;estado&quot;: &quot;pendiente&quot;, &quot;observacion&quot;: &quot;No se encuentra el documento t&#233;cnico para efectuar contraste.&quot;}, {&quot;item&quot;: &quot;Coherencia entre exigencias de admisibilidad y antecedentes del oferente adjudicado&quot;, &quot;estado&quot;: &quot;pendiente&quot;, &quot;observacion&quot;: &quot;No se encuentra oferta administrativa ni evaluaci&#243;n de admisibilidad.&quot;}], &quot;existencia&quot;: [{&quot;item&quot;: &quot;Bases administrativas generales&quot;, &quot;estado&quot;: &quot;cumple&quot;, &quot;observacion&quot;: &quot;Se encuentra documento denominado \\&quot;02. Bases administrativas de licitaci&#243;n.pdf\\&quot;.&quot;}, {&quot;item&quot;: &quot;Bases administrativas especiales&quot;, &quot;estado&quot;: &quot;cumple&quot;, &quot;observacion&quot;: &quot;Se encuentra documento denominado \\&quot;03. Bases administrativas especiales.pdf\\&quot;.&quot;}, {&quot;item&quot;: &quot;Bases t&#233;cnicas&quot;, &quot;estado&quot;: &quot;no_se_encuentra&quot;, &quot;observacion&quot;: &quot;Las bases especiales remiten a bases t&#233;cnicas, pero dicho antecedente no fue advertido en la documentaci&#243;n revisada.&quot;}, {&quot;item&quot;: &quot;Contrato suscrito&quot;, &quot;estado&quot;: &quot;no_se_encuentra&quot;, &quot;observacion&quot;: &quot;No se encuentra contrato en el expediente aportado.&quot;}, {&quot;item&quot;: &quot;Resoluci&#243;n aprobatoria del contrato&quot;, &quot;estado&quot;: &quot;no_se_encuentra&quot;, &quot;observacion&quot;: &quot;No se encuentra respaldo documental suficiente.&quot;}, {&quot;item&quot;: &quot;Resoluci&#243;n de adjudicaci&#243;n&quot;, &quot;estado&quot;: &quot;no_se_encuentra&quot;, &quot;observacion&quot;: &quot;No se encuentra acto administrativo de adjudicaci&#243;n.&quot;}, {&quot;item&quot;: &quot;Oferta del adjudicatario&quot;, &quot;estado&quot;: &quot;no_se_encuentra&quot;, &quot;observacion&quot;: &quot;No se encuentra oferta t&#233;cnica, econ&#243;mica ni administrativa del adjudicatario.&quot;}, {&quot;item&quot;: &quot;Garant&#237;a de seriedad de la oferta&quot;, &quot;estado&quot;: &quot;no_se_encuentra&quot;, &quot;observacion&quot;: &quot;Las bases la exigen, pero no se acompa&#241;a copia del instrumento ni constancia de recepci&#243;n.&quot;}, {&quot;item&quot;: &quot;Consultas y respuestas del proceso&quot;, &quot;estado&quot;: &quot;no_se_encuentra&quot;, &quot;observacion&quot;: &quot;No se encuentran antecedentes de consultas ni aclaraciones.&quot;}, {&quot;item&quot;: &quot;Acta de reuni&#243;n informativa&quot;, &quot;estado&quot;: &quot;no_se_encuentra&quot;, &quot;observacion&quot;: &quot;Las bases especiales la contemplan como obligatoria, pero no se aporta el acta.&quot;}, {&quot;item&quot;: &quot;Anexos y formularios del proceso&quot;, &quot;estado&quot;: &quot;no_se_encuentra&quot;, &quot;observacion&quot;: &quot;No se encuentran anexos ni formularios publicados o completados.&quot;}, {&quot;item&quot;: &quot;Cronograma del proceso&quot;, &quot;estado&quot;: &quot;cumple&quot;, &quot;observacion&quot;: &quot;Se encuentra regulado en las bases administrativas especiales.&quot;}, {&quot;item&quot;: &quot;Objeto de la licitaci&#243;n&quot;, &quot;estado&quot;: &quot;cumple&quot;, &quot;observacion&quot;: &quot;Se encuentra expresamente definido en las bases administrativas especiales.&quot;}], &quot;cumplimiento&quot;: [{&quot;item&quot;: &quot;Existencia de formalizaci&#243;n contractual conforme a bases&quot;, &quot;estado&quot;: &quot;pendiente&quot;, &quot;observacion&quot;: &quot;Las bases especiales exigen suscripci&#243;n de contrato, pero no se encuentra respaldo documental suficiente para verificar su formalizaci&#243;n.&quot;}, {&quot;item&quot;: &quot;Presentaci&#243;n de garant&#237;a de seriedad conforme a bases&quot;, &quot;estado&quot;: &quot;pendiente&quot;, &quot;observacion&quot;: &quot;No es posible concluir con certeza por falta del instrumento y de constancia de recepci&#243;n o validaci&#243;n.&quot;}, {&quot;item&quot;: &quot;Cumplimiento del requisito de reuni&#243;n informativa obligatoria&quot;, &quot;estado&quot;: &quot;pendiente&quot;, &quot;observacion&quot;: &quot;No se encuentra acta ni registro de asistencia que permita verificar el cumplimiento.&quot;}, {&quot;item&quot;: &quot;Cumplimiento de entrega de formularios administrativos exigidos&quot;, &quot;estado&quot;: &quot;pendiente&quot;, &quot;observacion&quot;: &quot;No se encuentra la oferta administrativa ni sus formularios.&quot;}, {&quot;item&quot;: &quot;Cumplimiento de requisitos aplicables a UTP, si correspondiere&quot;, &quot;estado&quot;: &quot;pendiente&quot;, &quot;observacion&quot;: &quot;No es posible concluir; no se encuentra informaci&#243;n sobre participaci&#243;n de uni&#243;n temporal de proveedores.&quot;}, {&quot;item&quot;: &quot;Cumplimiento de exigencias t&#233;cnicas del servicio&quot;, &quot;estado&quot;: &quot;pendiente&quot;, &quot;observacion&quot;: &quot;No se encuentra respaldo documental suficiente, debido a la ausencia de bases t&#233;cnicas y oferta t&#233;cnica.&quot;}]}, &quot;hallazgos&quot;: [{&quot;titulo&quot;: &quot;Expediente incompleto para revisi&#243;n contractual&quot;, &quot;criticidad&quot;: &quot;alta&quot;, &quot;descripcion&quot;: &quot;No se encuentra respaldo documental suficiente del contrato suscrito, resoluci&#243;n aprobatoria del contrato, resoluci&#243;n de adjudicaci&#243;n, bases t&#233;cnicas, oferta del adjudicatario, garant&#237;as presentadas, consultas y respuestas, anexos ni actas del proceso. La ausencia de dichos antecedentes impide revisar concordancia integral, exigibilidad documental y trazabilidad del expediente conforme a la jerarqu&#237;a aplicable.&quot;, &quot;tipo_riesgo&quot;: &quot;control&quot;, &quot;recomendacion&quot;: &quot;Completar el expediente con los documentos de mayor jerarqu&#237;a y de soporte del procedimiento antes de emitir una conclusi&#243;n sobre coherencia contractual o cumplimiento.&quot;}, {&quot;titulo&quot;: &quot;Imposibilidad de verificar concordancia bases-adjudicaci&#243;n-contrato&quot;, &quot;criticidad&quot;: &quot;alta&quot;, &quot;descripcion&quot;: &quot;Solo consta documentaci&#243;n base del proceso. No es posible concluir si el eventual contrato replica las condiciones obligatorias de las bases, si la adjudicaci&#243;n respet&#243; dichas condiciones o si existen adiciones contractuales no previstas.&quot;, &quot;tipo_riesgo&quot;: &quot;juridico&quot;, &quot;recomendacion&quot;: &quot;Incorporar resoluci&#243;n de adjudicaci&#243;n, contrato suscrito y, de existir, resoluci&#243;n aprobatoria, para verificar monto, plazo, garant&#237;as, obligaciones y eventuales cl&#225;usulas adicionales.&quot;}, {&quot;titulo&quot;: &quot;Falta de bases t&#233;cnicas&quot;, &quot;criticidad&quot;: &quot;alta&quot;, &quot;descripcion&quot;: &quot;Las bases administrativas especiales remiten expresamente a bases t&#233;cnicas para definir el servicio contratado, pero ese documento no fue advertido en la documentaci&#243;n revisada. En consecuencia, no es posible concluir sobre alcance t&#233;cnico, prestaciones exigibles, est&#225;ndares de servicio, cobertura, frecuencias ni criterios t&#233;cnicos de cumplimiento.&quot;, &quot;tipo_riesgo&quot;: &quot;administrativo&quot;, &quot;recomendacion&quot;: &quot;Agregar las bases t&#233;cnicas al expediente de revisi&#243;n para permitir el an&#225;lisis de objeto, obligaciones t&#233;cnicas y coherencia posterior con oferta y contrato.&quot;}, {&quot;titulo&quot;: &quot;Requisito de reuni&#243;n informativa obligatoria pendiente de respaldo&quot;, &quot;criticidad&quot;: &quot;media&quot;, &quot;descripcion&quot;: &quot;Las bases administrativas especiales establecen reuni&#243;n informativa de car&#225;cter obligatoria y certificada mediante acta firmada. No se encuentra el acta ni antecedentes que permitan verificar su realizaci&#243;n, asistencia de oferentes o tratamiento en la admisibilidad de ofertas.&quot;, &quot;tipo_riesgo&quot;: &quot;control&quot;, &quot;recomendacion&quot;: &quot;Incorporar acta de reuni&#243;n informativa y antecedentes de asistencia para verificar trazabilidad del requisito y su incidencia en la evaluaci&#243;n de ofertas.&quot;}, {&quot;titulo&quot;: &quot;Garant&#237;a de seriedad no verificable documentalmente&quot;, &quot;criticidad&quot;: &quot;media&quot;, &quot;descripcion&quot;: &quot;Las bases especiales regulan de manera detallada la garant&#237;a de seriedad de la oferta, pero no se encuentra respaldo de su presentaci&#243;n efectiva ni de su conformidad formal. No es posible concluir sobre suficiencia de cobertura, vigencia o glosa del instrumento.&quot;, &quot;tipo_riesgo&quot;: &quot;financiero&quot;, &quot;recomendacion&quot;: &quot;Acompa&#241;ar copia de la garant&#237;a presentada y constancia de recepci&#243;n o validaci&#243;n electr&#243;nica para revisar su conformidad con las bases.&quot;}, {&quot;titulo&quot;: &quot;Antecedentes de admisibilidad de oferentes no verificables&quot;, &quot;criticidad&quot;: &quot;media&quot;, &quot;descripcion&quot;: &quot;Las bases especiales exigen formularios administrativos, declaraciones de inhabilidad, conflicto de inter&#233;s, subcontrataci&#243;n y, en su caso, antecedentes de UTP. Ninguno de esos antecedentes fue incorporado en la revisi&#243;n, por lo que no es posible concluir respecto de admisibilidad, integridad de oferta administrativa ni cumplimiento documental de los oferentes.&quot;, &quot;tipo_riesgo&quot;: &quot;administrativo&quot;, &quot;recomendacion&quot;: &quot;Agregar oferta administrativa completa del adjudicatario y, si se revisa el proceso, los antecedentes de admisibilidad evaluados por la entidad.&quot;}]}</span>\"
