    \"<span class=sf-dump-key>tipo_ejecucion</span>\" => \"<span class=sf-dump-str title=\"6 characters\">openai</span>\"
    \"<span class=sf-dump-key>resumen</span>\" => \"<span class=sf-dump-str title=\"1336 characters\">Tipo: Licitaci&#243;n p&#250;blica para servicio de mantenci&#243;n preventiva y correctiva de calderas de calefacci&#243;n || Entidad: Corporaci&#243;n Administrativa del Poder Judicial || Riesgo general: alto || Observaciones clave: La documentaci&#243;n revisada corresponde solo a bases administrativas generales y especiales; no se encuentra contrato suscrito, resoluci&#243;n de adjudicaci&#243;n, resoluci&#243;n aprobatoria, bases t&#233;cnicas, oferta adjudicataria ni dem&#225;s antecedentes esenciales del expediente. | No es posible evaluar alineaci&#243;n entre bases, adjudicaci&#243;n y contrato por ausencia de documentos de jerarqu&#237;a superior y de ejecuci&#243;n del proceso. | Las bases administrativas generales contienen una regla de prelaci&#243;n documental distinta de la jerarqu&#237;a metodol&#243;gica instruida para esta revisi&#243;n; para efectos del an&#225;lisis solo puede verificarse coherencia interna parcial entre ambas bases. | La reuni&#243;n informativa es calificada como obligatoria en las bases administrativas especiales, lo que constituye un requisito relevante de admisibilidad o participaci&#243;n que queda pendiente de verificar por falta de acta o antecedentes del proceso. | Se establece garant&#237;a de seriedad de la oferta con exigencias espec&#237;ficas de monto, vigencia, glosa, beneficiario y forma de entrega; su existencia y suficiencia no pueden verificarse con la documentaci&#243;n disponible.</span>\"
    \"<span class=sf-dump-key>json_resultado</span>\" => \"<span class=sf-dump-str title=\"10185 characters\">{&quot;resumen&quot;: {&quot;entidad&quot;: &quot;Corporaci&#243;n Administrativa del Poder Judicial&quot;, &quot;tipo_contrato&quot;: &quot;Licitaci&#243;n p&#250;blica para servicio de mantenci&#243;n preventiva y correctiva de calderas de calefacci&#243;n&quot;, &quot;riesgo_general&quot;: &quot;alto&quot;, &quot;observaciones_clave&quot;: [&quot;La documentaci&#243;n revisada corresponde solo a bases administrativas generales y especiales; no se encuentra contrato suscrito, resoluci&#243;n de adjudicaci&#243;n, resoluci&#243;n aprobatoria, bases t&#233;cnicas, oferta adjudicataria ni dem&#225;s antecedentes esenciales del expediente.&quot;, &quot;No es posible evaluar alineaci&#243;n entre bases, adjudicaci&#243;n y contrato por ausencia de documentos de jerarqu&#237;a superior y de ejecuci&#243;n del proceso.&quot;, &quot;Las bases administrativas generales contienen una regla de prelaci&#243;n documental distinta de la jerarqu&#237;a metodol&#243;gica instruida para esta revisi&#243;n; para efectos del an&#225;lisis solo puede verificarse coherencia interna parcial entre ambas bases.&quot;, &quot;La reuni&#243;n informativa es calificada como obligatoria en las bases administrativas especiales, lo que constituye un requisito relevante de admisibilidad o participaci&#243;n que queda pendiente de verificar por falta de acta o antecedentes del proceso.&quot;, &quot;Se establece garant&#237;a de seriedad de la oferta con exigencias espec&#237;ficas de monto, vigencia, glosa, beneficiario y forma de entrega; su existencia y suficiencia no pueden verificarse con la documentaci&#243;n disponible.&quot;]}, &quot;checklist&quot;: {&quot;coherencia&quot;: [{&quot;item&quot;: &quot;Coherencia del objeto entre bases administrativas generales y especiales&quot;, &quot;estado&quot;: &quot;cumple&quot;, &quot;observacion&quot;: &quot;Las bases generales regulan el marco del proceso y las especiales identifican el servicio espec&#237;fico de mantenci&#243;n preventiva y correctiva de calderas; no se advierte contradicci&#243;n expresa.&quot;}, {&quot;item&quot;: &quot;Coherencia de la formalizaci&#243;n mediante contrato con las bases revisadas&quot;, &quot;estado&quot;: &quot;cumple&quot;, &quot;observacion&quot;: &quot;Las bases especiales se&#241;alan que la contrataci&#243;n se formalizar&#225; mediante contrato, sin contradicci&#243;n con las bases generales revisadas.&quot;}, {&quot;item&quot;: &quot;Coherencia de reglas de prelaci&#243;n entre documentos revisados&quot;, &quot;estado&quot;: &quot;pendiente&quot;, &quot;observacion&quot;: &quot;Las bases generales establecen una prelaci&#243;n documental propia del proceso, distinta de la jerarqu&#237;a metodol&#243;gica instruida para esta revisi&#243;n. No constituye por s&#237; sola contradicci&#243;n invalidante, pero obliga a distinguir el orden interno de las bases del criterio anal&#237;tico aplicado en esta revisi&#243;n.&quot;}, {&quot;item&quot;: &quot;Coherencia de monto, plazo y garant&#237;as entre bases, adjudicaci&#243;n y contrato&quot;, &quot;estado&quot;: &quot;pendiente&quot;, &quot;observacion&quot;: &quot;No es posible concluir por ausencia de resoluci&#243;n de adjudicaci&#243;n y contrato suscrito.&quot;}, {&quot;item&quot;: &quot;Coherencia entre bases administrativas especiales y bases t&#233;cnicas&quot;, &quot;estado&quot;: &quot;pendiente&quot;, &quot;observacion&quot;: &quot;No se encuentra el documento t&#233;cnico para efectuar contraste.&quot;}, {&quot;item&quot;: &quot;Coherencia entre exigencias de admisibilidad y antecedentes del oferente adjudicado&quot;, &quot;estado&quot;: &quot;pendiente&quot;, &quot;observacion&quot;: &quot;No se encuentra oferta administrativa ni evaluaci&#243;n de admisibilidad.&quot;}], &quot;existencia&quot;: [{&quot;item&quot;: &quot;Bases administrativas generales&quot;, &quot;estado&quot;: &quot;cumple&quot;, 