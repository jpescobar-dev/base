    \"<span class=sf-dump-key>resumen</span>\" => \"<span class=sf-dump-str title=\"1082 characters\">Tipo: No se encuentra determinado con la documentaci&#243;n revisada; solo consta un proceso de licitaci&#243;n p&#250;blica regido por bases administrativas generales. || Entidad: Corporaci&#243;n Administrativa del Poder Judicial || Riesgo general: alto || Observaciones clave: La documentaci&#243;n revisada corresponde &#250;nicamente a Bases Administrativas Generales. | No se encuentra contrato suscrito, resoluci&#243;n aprobatoria, resoluci&#243;n de adjudicaci&#243;n, bases administrativas especiales, bases t&#233;cnicas, oferta del adjudicatario ni anexos del expediente. | No es posible efectuar una revisi&#243;n contractual integral ni verificar alineaci&#243;n entre bases, adjudicaci&#243;n y contrato por insuficiencia documental. | Las Bases Administrativas Generales contienen una regla interna de prelaci&#243;n documental aplicable al proceso, pero no se dispone de los documentos de mayor jerarqu&#237;a requeridos para contrastar coherencia espec&#237;fica del caso. | No se encuentran antecedentes suficientes para identificar objeto contractual espec&#237;fico, monto, plazo, garant&#237;as u obligaciones particulares del eventual adjudicatario.</span>\"
    \"<span class=sf-dump-key>json_resultado</span>\" => \"<span class=sf-dump-str title=\"8585 characters\">{&quot;resumen&quot;: {&quot;entidad&quot;: &quot;Corporaci&#243;n Administrativa del Poder Judicial&quot;, &quot;tipo_contrato&quot;: &quot;No se encuentra determinado con la documentaci&#243;n revisada; solo consta un proceso de licitaci&#243;n p&#250;blica regido por bases administrativas generales.&quot;, &quot;riesgo_general&quot;: &quot;alto&quot;, &quot;observaciones_clave&quot;: [&quot;La documentaci&#243;n revisada corresponde &#250;nicamente a Bases Administrativas Generales.&quot;, &quot;No se encuentra contrato suscrito, resoluci&#243;n aprobatoria, resoluci&#243;n de adjudicaci&#243;n, bases administrativas especiales, bases t&#233;cnicas, oferta del adjudicatario ni anexos del expediente.&quot;, &quot;No es posible efectuar una revisi&#243;n contractual integral ni verificar alineaci&#243;n entre bases, adjudicaci&#243;n y contrato por insuficiencia documental.&quot;, &quot;Las Bases Administrativas Generales contienen una regla interna de prelaci&#243;n documental aplicable al proceso, pero no se dispone de los documentos de mayor jerarqu&#237;a requeridos para contrastar coherencia espec&#237;fica del caso.&quot;, &quot;No se encuentran antecedentes suficientes para identificar objeto contractual espec&#237;fico, monto, plazo, garant&#237;as u obligaciones particulares del eventual adjudicatario.&quot;]}, &quot;checklist&quot;: {&quot;coherencia&quot;: [{&quot;item&quot;: &quot;Coherencia entre contrato, adjudicaci&#243;n y bases&quot;, &quot;estado&quot;: &quot;pendiente&quot;, &quot;observacion&quot;: &quot;No es posible verificar por falta de contrato, adjudicaci&#243;n y bases especiales/t&#233;cnicas.&quot;}, {&quot;item&quot;: &quot;Coherencia del objeto contractual entre documentos&quot;, &quot;estado&quot;: &quot;pendiente&quot;, &quot;observacion&quot;: &quot;No se encuentra respaldo documental suficiente para contrastar el objeto del